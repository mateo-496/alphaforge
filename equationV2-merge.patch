+    fs = q_bar_weighted(claims, FILINGS_CHANNEL_WEIGHTS, p=CLAIM_POWER)
+    mean_conf = sum(c.confidence for c in claims) / len(claims)
+    coverage = min(1.0, len(claims) / 5.0)
+    return {
