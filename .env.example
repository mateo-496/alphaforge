AWS_REGION=us-east-1
# AWS credentials: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN, or an instance role
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-5-5
SCENARIO_MODEL_ID=global.anthropic.claude-haiku-5-5
SEC_IDENTITY="AlphaForge Datathon you@yourdomain.com"   # a real email: the SEC requires it

# Optional
STORAGE=local                 # s3 -> caches, filings and scenarios in S3_BUCKET
S3_BUCKET=
CLOUDTRAIL_CHANNEL_ARN=       # arn:aws:cloudtrail:<region>:<account>:channel/<id> -> LLM traces to CloudTrail Lake
FILINGS_TOP_N=5               # largest equity holdings read by the filings agent
FILINGS_WAIT_S=0          # 0 = read every new company to the end and save it; N = wait N s, then continue (rest in background)
EXPOSURE_TEXT_WAIT_S=0    # 0 = read every new filing text to the end; N = per holding, then the prior is used
LLM_CACHE=1               # reuse saved agent answers for identical inputs (data/agent-cache); 0 = always call the model
RUN_CACHE_DAYS=7          # same portfolio + profile + date within N days -> the finished run is shown again; 0 = always run
REPLAY_STEP_S=0.8         # replay of a reused run: pause at each phase start / end (s)
REPLAY_GAP_S=0.08         # replay: minimum time between two progress lines (s)
REPLAY_HOLD_S=0.9         # replay: each holding / company / country stays "in progress" 1-2x this (s)
REPLAY_MAX_S=20           # replay: the original timeline is sped up to fit this (s), before the pauses above
# Vercel (see DEPLOY.md): set automatically there. STREAM_RUNS=1 runs each new analysis inside one streamed request.
# STREAM_RUNS=0
# DATA_DIR=data
